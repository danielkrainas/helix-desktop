#!/bin/sh
# Installed as /usr/libexec/helix/helix-greeter-session. greetd runs it as
# its greeter user (helix-desktop-spec components/greeter.md): the
# compositor on the bare hardware with the greeter as its shell, on a
# private session bus. When the greeter has handed greetd the session to
# start it exits with status 0, the compositor exits with it, and greetd
# starts the session.
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Helix
exec dbus-run-session -- helix-comp --backend drm --shell helix-greeter --exit-with-shell
