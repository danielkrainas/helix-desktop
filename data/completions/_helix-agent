#compdef helix-agent
# zsh completion for helix-agent (made by `helix-agent completions zsh`)
_helix_agent() {
    local at= w i prev=${words[CURRENT-1]}
    local known=" status request state windows apps workspaces monitors notifications files files/recent files/search wait wait/window wait/closed ask confirm remind remind/add remind/list remind/cancel open launch window workspace workspace/switch toggle set notify clipboard clipboard/get clipboard/set a11y a11y/tree a11y/do a11y/set screenshot input input/key input/type input/click input/move input/scroll log help completions "
    for ((i = 2; i < CURRENT; i++)); do
        w=${words[i]}
        [[ $w == -* ]] && continue
        if [[ $known == *" ${at:+$at/}$w "* ]]; then at=${at:+$at/}$w; fi
    done
    case $prev in
        --level) compadd -- read-only desktop apps screen-and-input; return ;;
        --app) _message 'app'; return ;;
        --limit) _message 'limit'; return ;;
        --type) _message 'type'; return ;;
        --since) _message 'since'; return ;;
        --until) _message 'until'; return ;;
        --in) _files; return ;;
        --title) _message 'title'; return ;;
        --timeout) _message 'timeout'; return ;;
        --choice) _message 'choice'; return ;;
        --default) _message 'default'; return ;;
        --yes) _message 'yes'; return ;;
        --no) _message 'no'; return ;;
        --icon) _message 'icon'; return ;;
        --urgency) compadd -- low normal; return ;;
        --depth) _message 'depth'; return ;;
        --node) _message 'node'; return ;;
        --window) _message 'window'; return ;;
        --monitor) _message 'monitor'; return ;;
        --output) _files; return ;;
        --button) _message 'button'; return ;;
        --agent) _message 'agent'; return ;;
    esac
    local -a commands
    case $at in
        "") commands=('status:Show whether agent access is on and what this agent may do' 'request:Ask the user for access now' 'state:Focused window, workspace and quick settings' 'windows:Open windows' 'apps:Installed and running apps' 'workspaces:Workspaces' 'monitors:Monitors' 'notifications:Recent notifications' 'files:Recent files and file search' 'wait:Wait for a window to appear or close' 'ask:Ask the user a question' 'confirm:Ask the user yes or no' 'remind:Reminders for the user' 'open:Open a file or URL in its app' 'launch:Start an app' 'window:Focus, move, tile or close a window' 'workspace:Switch workspaces' 'toggle:Turn a quick setting on or off' 'set:Set volume or brightness' 'notify:Show the user a notification' 'clipboard:Read or set the clipboard (needs Clipboard access)' 'a11y:Read and use an app'\''s controls' 'screenshot:Take a screenshot' 'input:Send keys, text, clicks and scrolling' 'log:Show what agents did' 'help:Help for a command, or "help exit-codes"' 'completions:Shell completions') ;;
        files) commands=('recent:Recently used files' 'search:Search for files') ;;
        wait) commands=('window:Wait until a matching window is open' 'closed:Wait until a window is closed') ;;
        remind) commands=('add:Add a reminder' 'list:This agent'\''s reminders' 'cancel:Cancel a reminder') ;;
        workspace) commands=('switch:Switch to a workspace') ;;
        clipboard) commands=('get:Read the clipboard' 'set:Set the clipboard') ;;
        a11y) commands=('tree:An app window'\''s controls' 'do:Use a control' 'set:Change a control'\''s value') ;;
        input) commands=('key:Press keys' 'type:Type text' 'click:Click at a point' 'move:Move the pointer' 'scroll:Scroll') ;;
    esac
    if (( ${#commands} )) && [[ ${words[CURRENT]} != -* ]]; then
        _describe command commands
        return
    fi
    case $at in
        "") compadd -- status request state windows apps workspaces monitors notifications files wait ask confirm remind open launch window workspace toggle set notify clipboard a11y screenshot input log help completions --json --text --no-ask --sensitive --timeout --help --version ;;
        status) compadd -- --json --text --no-ask --sensitive --timeout --help ;;
        request) compadd -- --level --json --text --no-ask --sensitive --timeout --help ;;
        state) compadd -- --json --text --no-ask --sensitive --timeout --help ;;
        windows) compadd -- --app --focused --json --text --no-ask --sensitive --timeout --help ;;
        apps) compadd -- --running --json --text --no-ask --sensitive --timeout --help ;;
        workspaces) compadd -- --json --text --no-ask --sensitive --timeout --help ;;
        monitors) compadd -- --json --text --no-ask --sensitive --timeout --help ;;
        notifications) compadd -- --limit --json --text --no-ask --sensitive --timeout --help ;;
        files/recent) compadd -- --limit --type --json --text --no-ask --sensitive --timeout --help ;;
        files/search) compadd -- --since --until --type --in --limit --json --text --no-ask --sensitive --timeout --help ;;
        wait/window) compadd -- --app --title --focused --timeout --json --text --no-ask --sensitive --timeout --help ;;
        wait/closed) compadd -- --timeout --json --text --no-ask --sensitive --timeout --help ;;
        ask) compadd -- --choice --default --timeout --json --text --no-ask --sensitive --timeout --help ;;
        confirm) compadd -- --yes --no --timeout --json --text --no-ask --sensitive --timeout --help ;;
        remind/add) compadd -- --json --text --no-ask --sensitive --timeout --help ;;
        remind/list) compadd -- --json --text --no-ask --sensitive --timeout --help ;;
        remind/cancel) compadd -- --json --text --no-ask --sensitive --timeout --help ;;
        open) compadd -- --app --json --text --no-ask --sensitive --timeout --help ;;
        launch) compadd -- --json --text --no-ask --sensitive --timeout --help ;;
        window) compadd -- focus close minimize maximize unmaximize fullscreen unfullscreen tile-left tile-right move resize to-workspace --json --text --no-ask --sensitive --timeout --help ;;
        workspace/switch) compadd -- --json --text --no-ask --sensitive --timeout --help ;;
        toggle) compadd -- dark-style do-not-disturb night-light wifi airplane-mode mute --json --text --no-ask --sensitive --timeout --help ;;
        set) compadd -- volume brightness --json --text --no-ask --sensitive --timeout --help ;;
        notify) compadd -- --icon --urgency --json --text --no-ask --sensitive --timeout --help ;;
        clipboard/get) compadd -- --type --json --text --no-ask --sensitive --timeout --help ;;
        clipboard/set) compadd -- --type --json --text --no-ask --sensitive --timeout --help ;;
        a11y/tree) compadd -- --depth --node --json --text --no-ask --sensitive --timeout --help ;;
        a11y/do) compadd -- --json --text --no-ask --sensitive --timeout --help ;;
        a11y/set) compadd -- --json --text --no-ask --sensitive --timeout --help ;;
        screenshot) compadd -- --window --monitor --output --json --text --no-ask --sensitive --timeout --help ;;
        input/key) compadd -- --json --text --no-ask --sensitive --timeout --help ;;
        input/type) compadd -- --json --text --no-ask --sensitive --timeout --help ;;
        input/click) compadd -- --button --json --text --no-ask --sensitive --timeout --help ;;
        input/move) compadd -- --json --text --no-ask --sensitive --timeout --help ;;
        input/scroll) compadd -- --json --text --no-ask --sensitive --timeout --help ;;
        log) compadd -- --agent --since --json --text --no-ask --sensitive --timeout --help ;;
        help) compadd -- status request state windows apps workspaces monitors notifications files wait ask confirm remind open launch window workspace toggle set notify clipboard a11y screenshot input log help completions exit-codes --json --text --no-ask --sensitive --timeout --help ;;
        completions) compadd -- bash zsh fish --json --text --no-ask --sensitive --timeout --help ;;
    esac
}
