# Copy to /etc/helix/greeter.toml to change the Helix greeter.

# false: always ask for the username instead of listing users.
#user-list = true

# Text shown under the clock.
#banner = "Authorized use only."

# 12h or 24h. Unset: the org.gnome.desktop.interface clock-format setting
# (system defaults and dconf overrides), else the system locale's format.
#clock-format = "24h"
